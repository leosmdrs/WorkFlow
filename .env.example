# Rota — variáveis de ambiente. Copie para `.env.local` e preencha.
# Nada aqui deve ser commitado com valores reais.

# --- Supabase (obtido via `supabase start` para local, ou dashboard para prod) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...substitua...

# --- Branding (permite trocar o nome do produto sem retrabalho) ---
VITE_APP_NAME=Rota
VITE_APP_TAGLINE=Gestão de processos SEI

# --- Ambiente ---
VITE_APP_ENV=development
