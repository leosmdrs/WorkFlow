{
  "name": "@rota/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "package": "vite build && cd dist && zip -r ../rota-extension.zip .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@rota/shared": "workspace:*",
    "@rota/db-types": "workspace:*",
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.28",
    "@types/chrome": "0.0.278",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.5"
  }
}
